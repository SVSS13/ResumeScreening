# ==============================================================================
# Resume Screener Backend Configuration & Secrets
# ==============================================================================

# API Keys & Secrets
GITHUB_TOKEN=                              # Optional: GitHub Personal Access Token (raises rate limit from 60 to 5,000 req/h)
LLM_PROVIDER=none                          # none | anthropic | openai
LLM_API_KEY=                               # Anthropic or OpenAI API key
LLM_MODEL=claude-haiku-5-5                 # Model name override
LLM_BASE_URL=                              # Custom base URL (optional)

# Rate Limiting Policies
RATE_LIMIT_WRITE_BURST=2                   # POST /screen burst capacity
RATE_LIMIT_WRITE_REFILL_PER_S=0.1          # POST /screen refill rate (6 req/min = 0.1/s)
RATE_LIMIT_READ_BURST=20                   # GET endpoints burst capacity
RATE_LIMIT_READ_REFILL_PER_S=2.0           # GET endpoints refill rate (120 req/min = 2.0/s)
RATE_LIMIT_MAX_KEYS=10000                  # Maximum tracked client identities in LRU

# Cache Limits & Sharding
CACHE_MAX_BYTES=268435456                  # 256 MB total across all caches
CACHE_SHARD_COUNT=16                       # Number of striped locks (powers of 2)
CACHE_GITHUB_TTL_HOURS=24.0                # GitHub enrichment cache TTL

# Runtime MemoryGuard & Eviction Hysteresis
MEMORY_HIGH_WATERMARK=0.80                 # High watermark (80% of CACHE_MAX_BYTES)
MEMORY_LOW_WATERMARK=0.60                  # Low watermark (60% of CACHE_MAX_BYTES)
MEMORY_RSS_SOFT_LIMIT_MB=512.0             # Process RSS soft ceiling triggering reclamation
MEMORY_CHECK_INTERVAL_S=5.0                # Daemon inspection frequency

# Worker Runtime & Job Queue
WORKER_PROCESSES=4                         # CPU worker processes (ProcessPoolExecutor)
WORKER_IO_THREADS=4                        # I/O worker threads (ThreadPoolExecutor)
JOB_QUEUE_MAX_SIZE=50                      # Bounded async queue size (emits 503 when full)
JOB_RETENTION_LIMIT=1000                   # Completed jobs retained in LRU store
SHUTDOWN_TIMEOUT_S=15.0                    # Graceful shutdown draining period
